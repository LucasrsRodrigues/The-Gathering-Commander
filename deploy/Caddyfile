# Replace jogo.seudominio.com with your domain. Caddy gets and renews the HTTPS certificate on its own.
jogo.seudominio.com {
	encode zstd gzip

	# Online server (same origin as the app: no CORS needed in production).
	handle /api/* {
		reverse_proxy server:8787
	}
	handle /ws {
		reverse_proxy server:8787
	}

	# The web app (static files from `npm run build -w @gathering-hall/web`).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}
